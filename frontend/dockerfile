FROM debian:bullseye AS build-env

RUN apt-get update && apt-get install -y \
    curl \
    git \
    wget \
    unzip \
    gdb \
    libstdc++6 \
    libglu1-mesa \
    python3 \
    sed \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Force tar to ignore ownership from archives
RUN printf '#!/bin/sh\nexec /bin/tar --no-same-owner "$@"\n' > /usr/local/bin/tar \
 && chmod +x /usr/local/bin/tar

RUN git clone https://github.com/flutter/flutter.git /usr/local/flutter

ENV PATH="/usr/local/bin:/usr/local/flutter/bin:/usr/local/flutter/bin/cache/dart-sdk/bin:${PATH}"
ENV FLUTTER_SUPPRESS_ANALYTICS=true
ENV CI=true

RUN flutter config --no-analytics

RUN mkdir /app/
COPY . /app/
WORKDIR /app/

RUN flutter pub get
RUN flutter build web

FROM nginx:1.21.1-alpine
COPY --from=build-env /app/build/web /usr/share/nginx/html